# hindsight-bench environment (copy to a git-ignored local file or export directly)
# Values are examples; never commit real credentials or private hostnames.

# OpenRouter (required for live model/rerank suites; read from the environment only)
OPENROUTER_API_KEY=

# Hindsight (required for live recall/dry-run suites)
HINDSIGHT_BENCH_HINDSIGHT_API_URL=http://127.0.0.1:8888
HINDSIGHT_BENCH_BANK=
# Optional bearer token if your Hindsight instance requires one
HINDSIGHT_API_TOKEN=

# Optional overrides (all also settable via CLI flags, which win)
# HINDSIGHT_BENCH_MODE=offline
# HINDSIGHT_BENCH_RUNS=3
# HINDSIGHT_BENCH_CONCURRENCY=8
# HINDSIGHT_BENCH_CANDIDATE_CAPS=50,100,200,300
# HINDSIGHT_BENCH_OUT=
